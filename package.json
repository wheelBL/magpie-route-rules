{
  "name": "magpie-route-rules",
  "version": "0.3.39",
  "description": "Request-aware routing rules with self-learning (image capability + failure actions via AI/rule classification) as a magpie gateway middleware, with a GUI page for the learning state",
  "type": "module",
  "main": "./route-rules.middleware.js",
  "files": [
    "route-rules.middleware.js",
    "page",
    "tools",
    "README.md"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "routing",
    "model-routing",
    "llm-gateway"
  ],
  "license": "MIT",
  "magpie": {
    "middleware": "./route-rules.middleware.js",
    "page": {
      "title": "Route rules",
      "file": "page/index.html",
      "titles": {
        "zh": "路由规则学习"
      }
    },
    "panels": [
      {
        "slot": "usage",
        "file": "page/panel.html",
        "title": "Model priority",
        "titles": {
          "zh": "模型优先级"
        }
      }
    ],
    "options": {
      "rules": [
        {
          "type": "images",
          "target": "<视觉模型，如 provider/vision-model>",
          "fallbacks": [
            "<第二候选>",
            "<第三候选>"
          ]
        }
      ],
      "clamp": true
    }
  }
}
