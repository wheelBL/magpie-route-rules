{
  "name": "magpie-route-rules",
  "version": "0.3.0",
  "description": "Request-aware routing rules with self-learning (image capability + failure actions via AI/rule classification) as a magpie gateway middleware",
  "type": "module",
  "files": ["route-rules.middleware.js", "README.md"],
  "keywords": ["magpie", "magpie-middleware", "routing", "model-routing", "llm-gateway"],
  "license": "MIT",
  "magpie": {
    "middleware": "./route-rules.middleware.js",
    "options": {
      "rules": [
        { "type": "images", "target": "cannbot/deepseek-v4.1-flash", "fallbacks": ["cannbot/glm-5.3", "cannbot/qwen3.8-max"] },
        { "type": "input", "at": 100000, "target": "cannbot/deepseek-v4.1-flash" },
        { "type": "output", "at": 4096, "target": "cannbot/glm-5.3" }
      ],
      "limits": { "cannbot/deepseek-v4.1-flash": 4096 },
      "clamp": true,
      "learned": { "images": {} },
      "learningTtlMs": 21600000
    }
  }
}
